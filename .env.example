# ============================================================
# CMPDI AI — Mining Intelligence Command Center
# Environment configuration template
#
# COPY this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Django core
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database
# Development: leave blank to use SQLite (backend/db.sqlite3)
# Production:  postgresql://user:password@host:5432/dbname
DATABASE_URL=

# CORS — origins allowed to call the API
# Comma-separated list of origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Media / Storage
# Development: leave blank (uses local filesystem at backend/media/)
# Production:  set to s3, gcs, etc. (future Phase 3+)
STORAGE_BACKEND=local
MEDIA_ROOT=

# Static files
STATIC_ROOT=

# AI / External services — Phase 2+ only
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ============================================================
# Development / Demo Seed User
# Used by: python manage.py seed_dev_user
#
# REQUIRED — seed_dev_user will abort if these are not set.
# Choose your own values. DO NOT use real production credentials.
# ============================================================
DEV_USER_USERNAME=admin
DEV_USER_PASSWORD=change-this-to-a-local-password
DEV_USER_EMAIL=admin@cmpdi.local
