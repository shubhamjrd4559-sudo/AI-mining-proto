# ============================================================
# SIH26023 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to the repository.
# ============================================================

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite used for prototype, PostgreSQL-ready)
# DATABASE_URL=sqlite:///db.sqlite3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Media / File Storage
MEDIA_ROOT=media/
# STORAGE_BACKEND=local

# API Base URL (for frontend)
API_BASE_URL=http://localhost:8000/api

# Future AI Provider (not used in Phase 1)
# AI_PROVIDER=openai
# AI_API_KEY=your-api-key-here

# Future Object Storage (not used in Phase 1)
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=
